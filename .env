DEBUG_SERVER=1
# Bielik (chat)
BIELIK_BASE_URL=https://bielik-11b-v2-6-krus-chatbox.apps.core.symmetry.pl/v1
BIELIK_MODEL_ID=bielik-11b-v2-6     # <- NAJWAŻNIEJSZE: bez "speakleash/..."


# E5 (embeddings)
E5_BASE_URL=https://multilingual-e5-krus-chatbox.apps.core.symmetry.pl/v1
EMBEDDER_MODEL_T=multilingual-e5
EMBEDDER_MODEL_U=multilingual-e5

# Rerankery (/v1/score)
BGE_BASE_URL=https://bge-reranker-v2-krus-chatbox.apps.core.symmetry.pl/v1/rerank
RADLAB_BASE_URL=https://bge-reranker-v2-krus-chatbox.apps.core.symmetry.pl/v1/rerank                              #https://polish-cross-encoder-krus-chatbox.apps.core.symmetry.pl/v1
RERANKER_MODEL_T=bge-reranker-v2
RERANKER_MODEL_U=polish-cross-encoder

# Chroma + dane
CHROMA_WIPE_ON_START=false
PERSIST_DIR=./chroma_statystyki
PERSIST_PATH=./chroma_ustawa
CSV_DIR=./data/all_data.csv
DATA_PATH=./data/ustawa_with_paragraph_headers.md

# chunking dla ustawy (indeks)
USTAWA_CHUNK_CHARS=900
USTAWA_CHUNK_OVERLAP=120

# limity klienta embeddings
EMBED_BATCH=16
EMBED_MAX_TOTAL_CHARS=40000
